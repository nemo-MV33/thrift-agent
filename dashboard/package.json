{
  "name": "thrift-dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c gray,blue \"tsx watch server.ts\" \"vite\"",
    "server": "tsx server.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^5.4.21"
  }
}
